# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public base URL used in auth email redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push public key (generate a pair with: npx web-push generate-vapid-keys)
# Leave empty to turn push notifications off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Maximum voice recording length in seconds (1-600, default 180)
NEXT_PUBLIC_MAX_RECORDING_SECONDS=180

# ---- Server-only secrets: never prefix with NEXT_PUBLIC_ ----

# Service role key: used only for account deletion, the cleanup job, storing
# processed profile pictures and delivering push notifications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/cleanup-audio (send as "Authorization: Bearer <secret>")
CRON_SECRET=generate-a-long-random-string

# Web push private key and contact (mailto: or https: URL; Apple rejects localhost)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- Scripts only (migrations and RLS integration tests) ----
# Use the session pooler string (Project Settings -> Database -> Connection string)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
